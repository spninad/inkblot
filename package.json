{
  "name": "inkblot",
  "version": "0.2.0",
  "description": "MDX scientific report generator and component library",
  "license": "MIT",
  "author": "Ninad",
  "homepage": "https://github.com/spninad/inkblot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spninad/inkblot.git"
  },
  "bugs": {
    "url": "https://github.com/spninad/inkblot/issues"
  },
  "keywords": [
    "mdx",
    "scientific-reports",
    "static-site",
    "react",
    "cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "bin": {
    "inkblot": "./dist/bin/inkblot.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./components": {
      "import": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts"
    },
    "./themes": {
      "import": "./dist/themes/index.js",
      "types": "./dist/themes/index.d.ts"
    },
    "./site": {
      "import": "./dist/site/index.js",
      "types": "./dist/site/index.d.ts"
    },
    "./next": {
      "import": "./dist/next/index.js",
      "types": "./dist/next/index.d.ts"
    },
    "./style.css": "./dist/style.css",
    "./site.css": "./dist/site.css",
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "tsup",
    "dev": "bun --bun tsup --watch",
    "test": "bun run tests/test-api.ts && bun run tests/test-edge-cases.ts && bun run tests/test-next-adapter.ts && bun run tests/test-site-server.ts && bun run tests/test-visualizations.ts && bun run tests/test-visual-qa.ts",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "preview": "bun tests/preview.ts"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "archiver": "^8.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "commander": "^15.0.0",
    "esbuild": "^0.28.2",
    "gray-matter": "^4.0.3",
    "katex": "^0.19.0",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "postcss": "^8.5.32",
    "postcss-prefix-selector": "^2.2.1",
    "shadcn": "4.23.0",
    "tailwindcss": "^4.3.5",
    "tsup": "^8.5.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.3"
  }
}
